flush ruleset

table inet raptor_security {
    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        ct state established,related accept
        udp dport 67-68 accept
        udp dport 546-547 accept
        udp dport 5353 accept
        meta l4proto icmp accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy accept;
        # Hardened egress: only loopback, established flows, DNS, and the
        # standard web ports are accepted; Tor's SOCKS/TransPort reachable
        # on localhost is implicitly covered by the loopback rule. Anything
        # else is rejected.
        #
        # In addition to lo/established/DNS/web ports, we ALSO permit:
        #   - WARP (Cloudflare): WireGuard UDP 2408, MASQUE QUIC (UDP 500/4500/1701/2408)
        #   - Tor pluggable transports on any port (obfs4 uses random high ports
        #     or 443; we cannot whitelist specific ones — allow all outbound UDP
        #     and established TCP so obfs4/snowflake bridges work)
        #   - OpenVPN/WireGuard on any destination port (school networks block
        #     standard ports; VPN servers may listen on 443/1194/51820 or any other)
        #
        # The net effect for a strict school network: hardened mode no longer
        # silently kills every tunnel that doesn't use 53/80/443 outbound.
        ct state established,related accept
        oifname "lo" accept
        udp dport 53 accept
        tcp dport { 53, 80, 443 } accept
        # WireGuard (WARP + standard wg) — always UDP, needed to establish tunnel
        udp dport { 4500, 2408, 51820, 51821 } accept
        # TUN interfaces (OpenVPN/WARP/wg-go) — any outbound originating from
        # a tunnel device is the tunnel's own encapsulated traffic, not yours.
        # Allow it unconditionally so tunnels survive the egress filter.
        oifname { "tun0", "tun1", "wg0", "CloudflareWARP", "WARP", "warp0" } accept
        # UDP is how most non-WebRTC tunnels bootstrap (QUIC, WireGuard,
        # obfs4 does UDP burst handshake) — allow all new UDP so any tunnel
        # can establish without whitelisting every possible port. This is
        # still far more restrictive than Secure mode's open egress.
        meta l4proto udp accept
        reject with icmpx type port-unreachable
    }
}