flush ruleset

table inet raptor_security {
    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        ct state established,related accept
        udp dport 67-68 accept
        udp dport 546-547 accept
        udp dport 5353 accept
        meta l4proto icmp accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy drop;
        oifname "lo" accept
        ct state established,related accept
        # Allow outbound only through loopback and established tunnel
        # traffic. VPN Manager's documented coupling expects tunnels to
        # come up on tun0/wg0 — see raptor_vpn_managerd.py's note about
        # this being a known gap for non-default interface names.
        # No general outbound is permitted otherwise.
    }
}