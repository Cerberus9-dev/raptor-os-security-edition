[Unit]
Description=Copy /etc/skel to live user home (fallback for live-config)
Before=lightdm.service
ConditionPathExists=/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'cp -rT /etc/skel/ /home/user/ && chown -R user:user /home/user'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target