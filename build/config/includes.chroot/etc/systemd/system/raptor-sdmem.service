[Unit]
Description=Raptor OS Volatile Memory Anti-Forensics Wipe
DefaultDependencies=no
# final.target jobs must be ordered BEFORE it; with After= the kernel's
# power-off is not blocked while the (potentially multi-GB) wipe drains.
Before=final.target

[Service]
Type=oneshot
ExecStart=/usr/bin/sdmem -f -ll
# sdmem -f -ll sweeps all RAM multiple times; the 90s default timeout would
# kill the wipe mid-flight and leave it silently truncated.
TimeoutStartSec=infinity

[Install]
WantedBy=final.target
