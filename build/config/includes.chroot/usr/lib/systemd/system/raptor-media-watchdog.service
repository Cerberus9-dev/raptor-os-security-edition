[Unit]
Description=Raptor OS power off when live medium is ejected
Documentation=https://github.com/Cerberus9-dev/Raptor-OS-Security-Edition
After=sysinit.target local-fs.target
Wants=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/raptor-media-watchdog
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target