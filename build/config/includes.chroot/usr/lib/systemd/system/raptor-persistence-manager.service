[Unit]
Description=Raptor Security Persistence Manager
Documentation=https://github.com/Cerberus9-dev/Raptor-OS-Security-Edition
After=dbus.service local-fs.target

[Service]
Type=dbus
BusName=org.raptor.PersistenceManager
ExecStart=/usr/bin/python3 /usr/lib/raptor-security/raptor_persistence_managerd.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
