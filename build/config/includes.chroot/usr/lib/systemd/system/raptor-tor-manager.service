[Unit]
Description=Raptor Security Tor Manager
Documentation=https://github.com/Cerberus9-dev/Raptor-OS-Security-Edition
After=dbus.service

[Service]
Type=dbus
BusName=org.raptor.TorManager
ExecStart=/usr/bin/python3 /usr/lib/raptor-security/raptor_tor_managerd.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
