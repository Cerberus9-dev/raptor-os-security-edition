#!/usr/bin/env bash
# Raptor OS — apply a mode's firewall through the Mode Manager daemon.
# Never touches nft directly; the daemon owns the ruleset.
set -euo pipefail

HELPER="/usr/lib/raptor-security/raptor-dbus-helper.py"
MODE="${1:-status}"

case "$MODE" in
    secure|hardened|lockdown)
        "$HELPER" ModeManager SetMode "$MODE"
        echo "[Raptor Firewall] ${MODE^^} mode applied via Mode Manager."
        ;;
    security)
        "$HELPER" ModeManager SetMode secure
        echo "[Raptor Firewall] SECURE mode applied via Mode Manager."
        ;;
    status)
        "$HELPER" ModeManager GetStatus | python3 -c \
            "import json,sys; print('firewall:', json.load(sys.stdin).get('firewall_active'))"
        ;;
    *)
        echo "Usage: $0 {secure|hardened|lockdown|status}" >&2
        exit 1
        ;;
esac