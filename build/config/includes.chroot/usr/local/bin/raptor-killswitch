#!/usr/bin/env bash
# Raptor OS — kill switch. Arms the daemon's Lockdown mode (full egress
# drop + NetworkManager/Tor stopped + radios blocked) and triggers the
# background RAM wipe. Disarming restores the mode that was active before.
set -euo pipefail

HELPER="/usr/lib/raptor-security/raptor-dbus-helper.py"
CONF_DIR="/etc/raptor"

ACTION="${1:-on}"

if [ "${ACTION,,}" = "on" ]; then
    mkdir -p "$CONF_DIR"
    PREV=$("$HELPER" ModeManager GetMode) || PREV="secure"
    case "$PREV" in secure|hardened|lockdown) ;; *) PREV="secure" ;; esac
    echo "$PREV" > "${CONF_DIR}/previous_mode"

    rfkill block all 2>/dev/null || true
    "$HELPER" ModeManager SetMode lockdown
    systemctl start raptor-ramwipe-now.service 2>/dev/null || true
    echo "Kill switch ARMED (Lockdown)."
else
    systemctl stop raptor-ramwipe-now.service 2>/dev/null || true
    rfkill unblock all 2>/dev/null || true

    PREV="secure"
    if [ -f "${CONF_DIR}/previous_mode" ]; then
        PREV=$(cat "${CONF_DIR}/previous_mode")
    fi
    case "$PREV" in secure|hardened|lockdown) ;; *) PREV="secure" ;; esac
    "$HELPER" ModeManager SetMode "$PREV"
    rm -f "${CONF_DIR}/previous_mode"
    echo "Kill switch disarmed — restored ${PREV^^} mode."
fi