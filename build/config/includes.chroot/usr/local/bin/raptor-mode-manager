#!/usr/bin/env bash
# Raptor OS — mode manager CLI (delegates to the Mode Manager daemon).
set -euo pipefail

MODE="${1:-status}"
BACKEND="/usr/local/bin/raptor-security"

case "$MODE" in
    secure|hardened|lockdown|security)
        exec "$BACKEND" "$MODE"
        ;;
    status)
        exec "$BACKEND" status
        ;;
    *)
        echo "Usage: $0 {secure|hardened|lockdown|security|status}" >&2
        exit 1
        ;;
esac